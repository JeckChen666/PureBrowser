   ],
   "fetch": [
    {
     "id": "api",
     "url": "https://channel.microcms.io/api/v1/media/{{match.id}}",
     "maxBytes": 131072,
     "hosts": [
      "microcms.io"
     ]
    }
   ],
   "note": "watch page (fetch.hosts declared): live-verified T109 (HLS master VERIFIED 4 variants 1080p via page requests; save honestly refused - AES-128 encrypted HLS, a never-support product line)."
  },
  {
