{
  "version": 3,
  "rules": [
    {
      "id": "ytdlp-medaltv",
      "version": 1,
      "match": {
        "hosts": "(^|\\.)medal\\.tv$",
        "path": "/games/[^/?#&]+/clips/(?<id>[^/?#&]+)"
      },
      "actions": [
        {
          "type": "jsonExtract",
          "pointers": [
            "contentUrlHls",
            "contentUrl"
          ]
        }
      ],
      "fetch": [
        {
          "id": "api",
          "url": "https://medal.tv/api/content/{{match.id}}",
          "maxBytes": 131072
        }
      ],
      "note": "medal.tv clip page: controlled fetch of the content API, jsonExtract surfaces contentUrlHls/contentUrl (HLS master + direct MP4); live-verified T100 (rule-surfaced VERIFIED 1080p HLS, save SUCCEEDED 16.2MB)."
    },
    {
      "id": "ytdlp-streamable",
      "version": 1,
      "match": {
        "hosts": "(^|\\.)streamable\\.com$",
        "path": "/(?:[es]/)?(?<id>\\w+)"
      },
      "actions": [
        {
          "type": "jsonExtract",
          "pointers": [
            "status",
            "reddit_title",
            "title",
            "description",
            "files",
            "thumbnail_url",
            "date_added",
            "duration"
          ]
        }
      ],
      "fetch": [
        {
          "id": "api",
          "url": "https://ajax.streamable.com/videos/{{match.id}}",
          "maxBytes": 131072
        }
      ],
      "note": "streamable.com clip page: controlled fetch of the ajax videos API (jsonExtract pointer set kept from transcription); live-verified T100 at site level (save SUCCEEDED 19.3MB via page candidates; rule pointers resolved to non-string containers)."
    },
    {
      "id": "ytdlp-hitrecord",
      "version": 1,
      "match": {
        "hosts": "(^|\\.)hitrecord\\.org$",
        "path": "/records/(?<id>\\d+)"
      },
      "actions": [
        {
          "type": "jsonExtract",
          "pointers": [
            "title",
            "source_url",
            "body",
            "duration",
            "created_at_i",
            "total_views_count",
            "hearts_count",
            "comments_count"
          ]
        }
      ],
      "fetch": [
        {
          "id": "api",
          "url": "https://hitrecord.org/api/web/records/{{match.id}}",
          "maxBytes": 131072
        }
      ],
      "note": "hitrecord.org record page: controlled fetch of the records API (jsonExtract pointer set kept from transcription); live-verified T100 at site level (save SUCCEEDED 71.9MB via page candidates; rule pointers resolved to non-string containers)."
    }
  ]
}